{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "tenants-v2",
	"compatibility_date": "2026-11-16",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "tenants-v2"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"observability": {
		"logs": {
			"enabled": false,
			"invocation_logs": true
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tenants-v2",
			"database_id": "af72d052-b5a7-46e3-95d4-19a2bff382a4",
			"migrations_dir": "drizzle"
		}
	],
	"keep_vars": true,
	"vars": {
		"APP_URL": "https://tenants-v2.linktowork.workers.dev",
		"MPESA_ENV": "sandbox",
		"MPESA_SHORTCODE": "174379",
		"SESSION_TTL_HOURS": "12",
		"NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAErF3hsR_a_pcPdh"
	}
}