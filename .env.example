# ── Local dev database (plain SQLite file) ──
# ONLY for local dev. Do NOT set it in wrangler.jsonc or the Cloudflare dashboard:
# production uses the D1 binding named DB, not a URL.
DATABASE_URL=file:./dev.db

# ── App ──
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string      # openssl rand -base64 48
SESSION_TTL_HOURS=12

# ── Cloudflare Turnstile (Cloudflare's official always-pass TEST keys) ──
# NEXT_PUBLIC_ is inlined at build time: in production also set it as a Build variable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── M-Pesa Daraja (C2B paybill) ──
# Generate with "openssl rand -hex 24"
MPESA_CALLBACK_SECRET=

# Generate with "openssl rand -base64 32"
SHORTCODE_ENC_KEY=

# Generate with "openssl rand -hex 24"
CRON_SECRET=

# ── Only for `bun run db:studio` against production (local .env only, optional) ──
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DATABASE_ID=
# CLOUDFLARE_D1_TOKEN=

# ── SMS (reserved, not used yet) ──
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_USERNAME=
# SMS_SENDER_ID=

# ── Deployment checklist ──
# 1. Cloudflare Dashboard → Worker → Settings → Variables and Secrets → Secret
#    Set these as encrypted Worker secrets (never put them in wrangler.jsonc):
#    SESSION_SECRET
#    TURNSTILE_SECRET_KEY
#    MPESA_CALLBACK_SECRET
#    CRON_SECRET
#
# 2. wrangler.jsonc → "vars"
#    Set these as non-secret runtime configuration:
#    APP_URL
#    SESSION_TTL_HOURS
#    NEXT_PUBLIC_TURNSTILE_SITE_KEY
#
# 3. Cloudflare Dashboard → Workers & Pages → Build → Build variables and secrets
#    Add NEXT_PUBLIC_TURNSTILE_SITE_KEY here. NEXT_PUBLIC_* values are embedded at build time,
#    so setting it only in Worker runtime variables or wrangler.jsonc may be too late.
#
# 4. Local-only production database tooling (optional, leave out of wrangler.jsonc):
#    CLOUDFLARE_ACCOUNT_ID
#    CLOUDFLARE_DATABASE_ID
#    CLOUDFLARE_D1_TOKEN
#
# 5. DATABASE_URL is local-only. Production uses the Cloudflare D1 binding named "DB".
